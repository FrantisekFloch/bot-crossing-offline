{
  "name": "bot-crossing-offline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An offline demo fork of Bot Crossing — a 3D colony of fabricated coding-agent bots, with access locked. Built on Bot Crossing by Jarren Rocks.",
  "license": "MIT",
  "author": "Frantisek Floch",
  "contributors": [
    "Jarren Rocks (original Bot Crossing)"
  ],
  "homepage": "https://github.com/FrantisekFloch/bot-crossing-offline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrantisekFloch/bot-crossing-offline.git"
  },
  "bugs": {
    "url": "https://github.com/FrantisekFloch/bot-crossing-offline/issues"
  },
  "keywords": [
    "three.js",
    "webgl",
    "colony-sim",
    "coding-agent",
    "visualization",
    "demo",
    "offline"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "vite": "^7.1.0"
  }
}
